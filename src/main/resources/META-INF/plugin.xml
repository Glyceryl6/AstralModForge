<idea-plugin>
    <id>dev.astral.modforge</id>
    <name>Astral Mod Forge</name>
    <version>0.2.0</version>
    <idea-version since-build="252"/>
    <vendor>Astral Mod Forge Community</vendor>
    <description><![CDATA[
        <p>Create standalone BepInEx IL2CPP MODs from checked C# classes with dependency verification,
        source-free DLL exports, per-MOD localization, and live compiler output.</p>
    ]]></description>
    <depends>com.intellij.modules.rider</depends>
    <resource-bundle>dev.astral.modforge.i18n.Messages</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.astral.modforge.ide.BuildLogService"/>
        <toolWindow id="Astral Mod Forge" anchor="bottom" icon="/icons/toolWindowIcon.svg"
                    factoryClass="dev.astral.modforge.ide.ForgeToolWindowFactory"/>
    </extensions>
    <actions resource-bundle="dev.astral.modforge.i18n.Messages">
        <group id="dev.astral.modforge.Tools" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <action id="dev.astral.modforge.New" class="dev.astral.modforge.ide.NewModAction" />
            <action id="dev.astral.modforge.Export" class="dev.astral.modforge.ide.ExportModAction" />
        </group>
    </actions>
</idea-plugin>
